# copy this file to .env and fill in at least one key.
# with no key at all the server runs in demo mode (sample trips, no AI).

# which provider to try first: gemini | groq | openrouter
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# optional - used as a fallback if the main provider is rate limited or down
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=8787
