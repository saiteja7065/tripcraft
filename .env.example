# copy this file to .env and fill in at least one key.
# with no key at all the server runs in demo mode (sample trips, no AI).
# free keys: console.groq.com, aistudio.google.com, openrouter.ai

# which provider to try first: groq | gemini | openrouter
# the others (if they have a key) are used as fallbacks when the first one
# is rate limited or down
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

PORT=8787
