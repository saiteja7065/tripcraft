{
  "name": "flam-trip-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Describe a trip in plain words, get an itinerary you can actually edit.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
